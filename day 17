✅------ delete node in LL---------
class Solution {
    Node deleteNode(Node head, int x) {
        // If deleting the head node
        if (x == 1) {
            head = head.next;
            return head;
        }
        
        // Traverse to the (x-1)th node
        Node temp = head;
        for (int i = 1; i < x - 1; i++) {
            temp = temp.next;
        }
        
        // Remove the xth node
        temp.next = temp.next.next;
        return head;
    }
}
