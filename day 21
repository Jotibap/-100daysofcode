✅- Find the unique element in an array 
public class Main {
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int[] arr = new int[n];
        
        for (int i = 0; i < n; i++){
            arr[i] = sc.nextInt();
        }
        unique(arr);
        System.out.println(unique(arr));
    }
    public static int unique(int[] arr){
        int ans = 0;
        for(int i=0; i<arr.length; i++){
            ans = (ans ^ arr[i]);
        }
        return ans;
    }
}
