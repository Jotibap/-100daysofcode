package org.example;

import org.hibernate.Session;
import org.hibernate.SessionFactory;
import org.hibernate.Transaction;
import org.hibernate.cfg.Configuration;

import java.util.Arrays;

public class Main {
    public static void main(String[] args) {

        Address a1 = new Address();
        a1.setAid(1);
        a1.setDist("Thane");
        a1.setPin(590001);

        Address a2 = new Address();
        a2.setAid(2);
        a2.setDist("Bandra");
        a2.setPin(590002);

        Address a3 = new Address();
        a3.setAid(3);
        a3.setDist("Navi Mumbai");
        a3.setPin(590003);

        Bio b1 = new Bio();
        b1.setSno(111);
        b1.setSname("Sam");
        b1.setState("Maharashtra");

        b1.setAddress(Arrays.asList(a1, a2, a3));

        a1.setBio(b1);
        a2.setBio(b1);
        a3.setBio(b1);


        SessionFactory sf = new Configuration()
                .configure()
                .addAnnotatedClass(org.example.Bio.class)
                .addAnnotatedClass(org.example.Address.class)
                .buildSessionFactory();

        Session session = sf.openSession();

        Transaction transaction = session.beginTransaction();

        session.persist(a1);
        session.persist(a2);
        session.persist(a3);
        session.persist(b1);

        transaction.commit();

        Bio b2 = session.get(Bio.class,111);
        System.out.println(b2);

        session.close();
        sf.close();;
    }
}

